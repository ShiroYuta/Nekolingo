{
  "name": "nekolingo",
  "productName": "Nekolingo",
  "version": "1.0.0",
  "description": "App gratuito para aprender inglês",
  "main": "electron/main.js",
  "author": "Joel",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.joel.nekolingo",
    "productName": "Nekolingo",
    "files": ["electron/**", "web/**", "package.json"],
    "directories": { "buildResources": "build" },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Nekolingo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "publish": [{ "provider": "github", "releaseType": "release" }]
  }
}
